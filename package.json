{
  "name": "securewipe-enterprise-ui",
  "version": "2.0.0",
  "private": true,
  "description": "SecureWipe Enterprise — Desktop UI",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder build",
    "electron:build:linux": "npm run build && electron-builder build --linux",
    "electron:build:mac": "npm run build && electron-builder build --mac",
    "electron:build:win": "npm run build && electron-builder build --win",
    "test": "react-scripts test",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",

    "lucide-react": "^0.383.0",
    "recharts": "^2.12.7",

    "date-fns": "^3.6.0",
    "clsx": "^2.1.1",

    "@tanstack/react-query": "^5.51.1",
    "zustand": "^4.5.4",

    "react-hot-toast": "^2.4.1",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",

    "qrcode.react": "^3.1.0",
    "jszip": "^3.10.1",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2"
  },
  "build": {
    "appId": "com.securewipe.enterprise",
    "productName": "SecureWipe Enterprise",
    "copyright": "Copyright © 2025 SecureWipe Enterprise",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "executableName": "securewipe-enterprise",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"],
    "rules": {
      "no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "browserslist": {
    "production": ["last 1 electron version"],
    "development": ["last 1 electron version"]
  }
}
